# Copy these into Vercel > Project > Settings > Environment Variables
# (for local development they are optional: without them a local file database is used)

# From Turso: turso db show <name> --url   /  turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# The first admin login (created on the first start; change the password later in Admin > Settings)
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional: lets Vercel Cron send the automatic 7:30 AM "Practice today" reminders
CRON_SECRET=any-long-random-text
